# ==============================================================================
# DOCKER COMPOSE ENVIRONMENT VARIABLES (Required)
# ==============================================================================

# --- PostgreSQL Configuration ---
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=mydb

# --- JWT Authentication ---
JWT_SECRET=your_jwt_secret_here
REFRESH_JWT_SECRET=your_refresh_jwt_secret_here

# --- Google OAuth Credentials ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# --- Resend Email Service ---
RESEND_API_KEY=your_resend_api_key
RESEND_EMAIL=onboarding@resend.dev


# ==============================================================================
# LOCAL DEVELOPMENT ONLY (Not used by Docker Compose)
# The following variables are handled internally by docker-compose.yml:
# - DATABASE_URL is constructed automatically from POSTGRES_* variables
# - REDIS_URL connects via container network (redis://redis:6379)
# - Ports and URLs are configured directly in docker-compose services
# ==============================================================================

# DATABASE_URL="postgresql://myuser:mypassword@localhost:5432/mydb"
# REDIS_URL="redis://localhost:6379"
# SERVER_PORT=3001
# WS_PORT=3002
# CLIENT_URL="http://localhost:3000"
# NEXT_PUBLIC_API_URL="http://localhost:3001"
# NEXT_PUBLIC_WS_URL="ws://localhost:3002"