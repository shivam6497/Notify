generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Authentication & User Model
// Represents dashboard administrators and developers owning projects.
// ============================================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  // Nullable for OAuth-only users
  name         String?
  picture      String?  // Avatar image URL (from Google OAuth)
  googleId     String?  @unique
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects Project[]
}

// ============================================================================
// Project Model
// Isolated multi-tenant workspace holding API keys, subscribers, and notifications.
// ============================================================================

model Project {
  id            String   @id @default(cuid())
  name          String
  userId        String
  webhookSecret String?  // HMAC-SHA256 signing secret for webhook payloads (whsec_...)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  apiKeys      ApiKey[]
  eventTypes   EventType[]
  subscribers  Subscriber[]
  notification Notification[]
}

// ============================================================================
// API Key Model
// Used for authenticating developer API requests to /v1/* endpoints.
// ============================================================================

model ApiKey {
  id         String    @id @default(cuid())
  projectId  String
  prefix     String    // Searchable identifier prefix (e.g. nk_live_abc12345)
  hash       String    // Bcrypt hash of the full raw key
  name       String?   // User-friendly label for the key
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime? // Timestamp when revoked (soft delete)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([prefix])
}

// ============================================================================
// Event Type Model
// Predefined notification topics/events and default delivery channels.
// ============================================================================

model EventType {
  id          String    @id @default(cuid())
  projectId   String
  slug        String    // Unique identifier within the project (e.g. "order-placed")
  description String?
  channels    Channel[] // Default delivery channels for this event
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, slug])
}

// ============================================================================
// Subscriber Model
// End-user / recipient identity mapped to an externalId from client systems.
// ============================================================================

model Subscriber {
  id         String   @id @default(cuid())
  projectId  String
  externalId String   // Unique user identifier in the client system (e.g. user_123)
  email      String?
  webhookUrl String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  project                 Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  notificationPreferences NotificationPreferences[]
  notifications           Notification[]

  @@unique([projectId, externalId])
}

// ============================================================================
// Notification Preferences Model
// Subscriber-specific opt-in / opt-out override settings per event & channel.
// ============================================================================

model NotificationPreferences {
  id           String  @id @default(cuid())
  subscriberId String
  eventSlug    String
  channel      Channel
  enabled      Boolean @default(true)

  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@unique([subscriberId, eventSlug, channel])
}

// ============================================================================
// Notification Model
// Record of an event triggered for a subscriber, including JSON payload.
// ============================================================================

model Notification {
  id             String   @id @default(cuid())
  projectId      String
  subscriberId   String
  eventSlug      String
  payload        Json     // Arbitrary event payload data
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subscriber   Subscriber    @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  deliveryLogs DeliveryLog[]
}

// ============================================================================
// Delivery Log Model
// Audit trail tracking delivery attempts, status, and failure reasons per channel.
// ============================================================================

model DeliveryLog {
  id             String         @id @default(cuid())
  notificationId String
  channel        Channel
  status         DeliveryStatus @default(PENDING)
  attemptCount   Int            @default(0)
  lastAttemptAt  DateTime?
  failureReason  String?        // Error details if delivery failed
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
}

// ============================================================================
// Enums
// ============================================================================

enum Channel {
  EMAIL
  WEBHOOK
  IN_APP
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
}
